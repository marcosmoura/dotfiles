{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",

  "historian": {
    "opencode": {
      "model": {
        "model": "opencode-go/deepseek-v4.1-flash",
      },
    },
  },

  "dreamer": {
    "disable": false,
    "opencode": {
      "model": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "high",
      },
    },
    "tasks": {
      "review-user-memories": { "schedule": "" },
    },
  },

  "embedding": {
    "provider": "local",
  },

  "memory": {
    "enabled": true,
    "auto_promote": true,
    "injection_budget_tokens": 4000,
  },

  "prompt_surface": {
    "default": "light",
  },
}
