{
  "$schema": "https://raw.githubusercontent.com/cortexkit/aft/v0.63.4/assets/aft.schema.json",
  "auto_update": false,
  "edit_mode": "default",
  "format_on_edit": false,
  "inspect": {
    "enabled": true,
    "categories": {
      "diagnostics": true,
      "todos": true,
      "dead_code": true,
      "unused_exports": true,
      "duplicates": true,
      "cycles": true,
      "complexity": true,
    },
  },

  // Read-only navigation; retain native reads, edits, patches and shell.
  "disabled_tools": [
    "read",
    "write",
    "edit",
    "apply_patch",
    "bash",
    "bash_status",
    "bash_watch",
    "bash_write",
    "bash_kill",
    "aft_safety",
    "aft_callgraph",
    "aft_import",
    "aft_conflicts",
    "aft_delete",
    "aft_move",
    "ast_grep_search",
    "ast_grep_replace",
  ],
  // Code Health Tier 2 (dead code, unused exports, duplicates, cycles,
  // complexity) reads a callgraph snapshot, so that index is required.
  "indexes": { "trigram": true, "semantic": true, "callgraph": true },

  // AFT runs only the language servers Code Health diagnostics need.
  // OpenCode keeps its own LSP sessions; the remaining AFT servers stay off.
  "lsp": {
    "auto_install": true,
    "disabled": [
      "python",
      "go",
      "bash",
      "yaml",
      "ty",
      "clojure-lsp",
      "dart",
      "elixir-ls",
      "fsharp",
      "gleam",
      "haskell-language-server",
      "jdtls",
      "julials",
      "nixd",
      "ocaml-lsp",
      "php-intelephense",
      "ruby-lsp",
      "csharp",
      "razor",
      "clangd",
      "lua-ls",
      "zls",
      "tinymist",
      "kotlin-ls",
      "texlab",
      "oxlint",
      "terraform",
      "vue",
      "astro",
      "prisma",
      "biome",
      "svelte",
      "dockerfile",
    ],
  },
}
