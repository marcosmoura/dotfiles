{
  "instructions": ["~/.config/opencode/rules/*.md"],

  "model": "openai/gpt-5.6-terra",

  "agents": {
    "title": {
      "model": "openai/gpt-5.6-luna#low"
    },

    "plan": {
      "model": "openai/gpt-5.6-sol#max"
    },

    "build": {
      "model": "openai/gpt-5.6-terra#high"
    },

    "explore": {
      "model": "openai/gpt-5.6-luna#low"
    },

    "compaction": {
      "model": "openai/gpt-5.6-luna#xhigh"
    },

    "general": {
      "model": "openai/gpt-5.6-terra#high"
    }
  },

  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false,
        "headers": {
          "CONTEXT7_API_KEY": "{file:~/.secrets/context7-key}"
        }
      },

      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      },

      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": false,
        "headers": {
          "Authorization": "{file:~/.secrets/gh-pat-key}"
        }
      },

      "shoogle": {
        "type": "remote",
        "url": "https://mcp.shoogle.dev/mcp",
        "disabled": false
      }
    }
  },

  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "git worktree *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "git -C *", "effect": "allow" },
    { "action": "shell", "resource": "cargo check *", "effect": "allow" },
    { "action": "shell", "resource": "cargo test *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-remote *", "effect": "allow" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "chown *", "effect": "ask" },
    { "action": "shell", "resource": "fd *", "effect": "allow" },
    { "action": "shell", "resource": "find . *", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "grep -r *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "node -e *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "python -c *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "type *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "codesearch", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "lsp", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "todoread", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },

    // Never let an agent pick its own git identity (e.g. opencode <opencode@local>).
    { "action": "shell", "resource": "*user.name=*", "effect": "deny" },
    { "action": "shell", "resource": "*user.email=*", "effect": "deny" },
    { "action": "shell", "resource": "git config*user.name *", "effect": "deny" },
    { "action": "shell", "resource": "git config*user.email *", "effect": "deny" },
    { "action": "shell", "resource": "*--author=*", "effect": "deny" },
    { "action": "shell", "resource": "*GIT_AUTHOR_NAME=*", "effect": "deny" },
    { "action": "shell", "resource": "*GIT_AUTHOR_EMAIL=*", "effect": "deny" },
    { "action": "shell", "resource": "*GIT_COMMITTER_NAME=*", "effect": "deny" },
    { "action": "shell", "resource": "*GIT_COMMITTER_EMAIL=*", "effect": "deny" }
  ],

  "plugins": [
    "~/Projects/dotfiles/tools/opencode/model-fallback",
    "~/Projects/dotfiles/tools/opencode/superpowers"
  ],

  "lsp": true,

  "websearch": {
    "provider": "random"
  },

  "experimental": {
    "subagent_depth": 3
  }
}
