{
  "$schema": "https://opencode.ai/v2/cli.json",

  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "image_preview": true,
    "new_location": "inherit",
    "permissions": "prompt",
    "verbosity": "medium"
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal",
    "scope": "cwd",
    "mode": "on",
    "indicators": "status"
  },
  "scroll": {
    "speed": 6,
    "acceleration": true
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "attention": {
    "volume": 0.3,
    "notifications": true,
    "sound": true
  },
  "plugins": ["./herdr-opencode"],
  "debug": {
    "devtools": false,
    "turn_tokens": true
  },
  "leader": {
    "timeout": 2500
  }
}
