# .zprofile: login shells, so once per terminal tab, before .zshrc.
#
# Environment only. Everything here is exported and inherited by whatever the
# shell starts, and nothing here forks.

# Homebrew, written out because `brew shellenv` costs a fork
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}"
export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
FPATH="/opt/homebrew/share/zsh/site-functions:${FPATH}"

# XDG base directories
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

# Editor and locale. nvim is always installed, through the Brewfile.
export EDITOR="nvim"
export VISUAL="$EDITOR"
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Pager
export LESS_TERMCAP_md=$'\e[1;33m'
export MANPAGER="less -X"
export PAGER="less"

# Where tools find their config and their own installs
export BAT_CONFIG_PATH="$XDG_CONFIG_HOME/bat/batconfig"
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship/starship.toml"
export BUN_INSTALL="$HOME/.bun"
export PNPM_HOME="$HOME/Library/pnpm"

# Graphify: semantic extraction through the Claude Code plan, no API key
export GRAPHIFY_BACKEND="claude-cli"
export GRAPHIFY_CLAUDE_CLI_MODEL="haiku"

# Colors for ls, eza and completion lists: Catppuccin Mocha, generated by
# vivid. topgrade rewrites the file (see ~/.config/topgrade/topgrade.toml).
export LS_COLORS="$(<$XDG_CONFIG_HOME/zsh/static/catppuccin-colors.txt)"
export EZA_ICON_SPACING=2

# fzf: search with fd, Catppuccin Mocha colors, previews with bat and eza
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS=" \
--color=fg:#cdd6f4,bg:#1e1e2e,hl:#f38ba8 \
--color=fg+:#cdd6f4,bg+:#313244,hl+:#f38ba8 \
--color=info:#cba6f7,prompt:#cba6f7,pointer:#f5e0dc \
--color=marker:#b4befe,spinner:#f5e0dc,header:#f38ba8 \
--color=gutter:#1e1e2e,border:#89b4fa \
--height=40% --layout=reverse --border=rounded \
--bind='ctrl-/:toggle-preview' \
--multi"
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always {} 2>/dev/null || cat {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} 2>/dev/null | head -100'"

# PATH. The first entry wins, entries appear once, and a directory that does
# not exist is left out.
#
# The mise shims make its tools work in shells that never show a prompt, such
# as `zsh -c` and scripts. In an interactive shell `mise activate` then puts
# the real tool directories ahead of everything here (see
# ~/.config/zsh/deferred/tools.zsh).
typeset -U path PATH
path=(
  $PNPM_HOME/bin(N-/)
  $BUN_INSTALL/bin(N-/)
  $XDG_DATA_HOME/mise/shims(N-/)
  $HOME/.luarocks/bin(N-/)
  /opt/homebrew/opt/rustup/bin(N-/)
  $HOME/.local/share/venv/bin(N-/)
  $HOME/.cargo/bin(N-/)
  $HOME/go/bin(N-/)
  $HOME/.config/yarn/global/node_modules/.bin(N-/)
  $HOME/.yarn/bin(N-/)
  $HOME/.opencode/bin(N-/)
  $HOME/.local/bin(N-/)
  $path
)
