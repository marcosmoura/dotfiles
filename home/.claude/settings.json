{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_FORCE_TERMINAL_IMAGES": "1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_SKIP_FAST_MODE_NETWORK_ERRORS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "OPENCODE_CONSOLE_HARNESS": "claude-cli/2.1.327",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_LOGS_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "https://opencode.ai/console/api/otel/v1/logs",
    "OTEL_LOGS_EXPORT_INTERVAL": "30000",
    "OTEL_LOG_USER_PROMPTS": "0",
    "OTEL_LOG_ASSISTANT_RESPONSES": "0",
    "OTEL_LOG_TOOL_DETAILS": "0",
    "OTEL_LOG_RAW_API_BODIES": "0",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "core.fsmonitor",
    "GIT_CONFIG_VALUE_0": "false"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(fd *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(tail *)",
      "Bash(type *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "deny": [
      "Bash(dd *)",
      "Bash(diskutil erase*)",
      "Bash(git -c user.*)",
      "Bash(git * -c user.*)",
      "Bash(git config *user.name*)",
      "Bash(git config *user.email*)",
      "Bash(git * config *user.name*)",
      "Bash(git * config *user.email*)",
      "Bash(git commit *--author*)",
      "Bash(*GIT_AUTHOR_*)",
      "Bash(*GIT_COMMITTER_*)",
      "Read(**/.env*)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)",
      "Read(~/.secrets/**)",
      "Read(~/.claude.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/opencode/service.json)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(rm -rf *)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "deck agent-event --agent claude",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/marcosmoura/.local/share/opencode-console/cli/opencode-console",
            "args": [
              "hook",
              "claude-code"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "deck agent-event --agent claude",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/marcosmoura/.local/share/opencode-console/cli/opencode-console",
            "args": [
              "hook",
              "claude-code"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/marcosmoura/.local/share/opencode-console/cli/opencode-console",
            "args": [
              "hook",
              "claude-code"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "deck agent-event --agent claude",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "deck agent-event --agent claude",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "deck agent-event --agent claude",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "deck agent-event --agent claude",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "deck agent-event --agent claude",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CORGI_PANE:-}\" ] && [ -n \"${CORGI_SOCKET:-}\" ] && [ -x \"${CORGI_BIN:-}\" ]; then \"$CORGI_BIN\" hook claude; fi",
            "timeout": 2,
            "statusMessage": "Reporting to Corgi"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/marcosmoura/.local/share/opencode-console/cli/opencode-console",
            "args": [
              "hook",
              "claude-code"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ],
    "baseRef": "head"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "humanizer@humanizer": true,
    "image-view@claude-image-view": false,
    "prismantis@prismantis": false,
    "sidebar@dotfiles": true
  },
  "extraKnownMarketplaces": {
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "dotfiles": {
      "source": {
        "source": "directory",
        "path": "/Users/marcosmoura/Projects/dotfiles/tools/claude"
      }
    }
  },
  "otelHeadersHelper": "/Users/marcosmoura/.local/share/opencode-console/cli/opencode-console otel-headers",
  "outputStyle": "concise",
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "xcodebuild *",
      "xcrun simctl *",
      "xcrun xcodebuild *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.local/state/mise/tracked-configs",
        "~/.local/state/mise/tracked-configs.expiry-start",
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/.cargo/.package-cache",
        "~/.cargo/.package-cache-mutate",
        "~/.cargo/.global-cache",
        "~/.bun/install/cache"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "mise.jdx.dev",
        "mise-versions.jdx.dev"
      ],
      "deniedDomains": [
        "telemetry.vercel.com"
      ]
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": true,
  "tui": "default",
  "timeFormat": "24-hour",
  "theme": "custom:catppuccin-mocha",
  "verbose": false,
  "preferredNotifChannel": "ghostty",
  "idleCompaction": false,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "GitHub repos under marcosmoura/* are owned by the user"
    ],
    "soft_deny": [
      "$defaults",
      "System Paths Outside the Sandbox: A command run with dangerouslyDisableSandbox that deletes, moves, truncates, chmods or chowns anything under /System, /Library, /Applications, /usr, /bin, /sbin, /etc, /private, /opt/homebrew or ~/Library (except ~/Library/Developer/CoreSimulator/Devices and ~/Library/Developer/Xcode/DerivedData), or that runs rm on a path built from a variable or command substitution the same command does not guard (for example `rm -rf \"$DIR/x\"` without `${DIR:?}` and a prefix check). An empty variable turns such a path into a system folder."
    ]
  }
}
