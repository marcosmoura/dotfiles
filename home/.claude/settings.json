{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_SKIP_FAST_MODE_NETWORK_ERRORS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(fd *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(tail *)",
      "Bash(type *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "deny": [
      "Bash(dd *)",
      "Bash(diskutil erase*)",
      "Bash(git -c user.*)",
      "Bash(git * -c user.*)",
      "Bash(git config *user.name*)",
      "Bash(git config *user.email*)",
      "Bash(git * config *user.name*)",
      "Bash(git * config *user.email*)",
      "Bash(git commit *--author*)",
      "Bash(*GIT_AUTHOR_*)",
      "Bash(*GIT_COMMITTER_*)",
      "Read(**/.env*)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)",
      "Read(~/.secrets/**)",
      "Read(~/.claude.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/opencode/service.json)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(rm -rf *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ],
    "baseRef": "head"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "humanizer@humanizer": true,
    "image-view@claude-image-view": true,
    "prismantis@prismantis": true,
    "sidebar@dotfiles": true
  },
  "extraKnownMarketplaces": {
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "claude-image-view": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-image-view"
      }
    },
    "prismantis": {
      "source": {
        "source": "github",
        "repo": "NahumLitvin/prismantis"
      }
    },
    "dotfiles": {
      "source": {
        "source": "directory",
        "path": "/Users/marcosmoura/Projects/dotfiles/tools/claude"
      }
    }
  },
  "outputStyle": "concise",
  "sandbox": {
    "enabled": true
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-2": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": true,
  "pluginConfigs": {
    "prismantis@prismantis": {
      "options": {
        "theme": "catppuccin-mocha",
        "tableStyle": "box",
        "taskStyle": "progress",
        "listMarker": "dots",
        "headingStyle": "banner",
        "copyButtonStyle": "inline",
        "promptStyle": "wide",
        "replyStyle": "auto",
        "bubbleLabels": "small",
        "clock": "24h",
        "toolStyle": "tree-dim",
        "toolOutput": "full",
        "diffStyle": "card",
        "codeStyle": "framed",
        "pieStyle": "bars"
      }
    }
  },
  "tui": "default",
  "timeFormat": "24-hour",
  "theme": "custom:catppuccin-mocha",
  "verbose": true,
  "preferredNotifChannel": "ghostty",
  "idleCompaction": false,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "GitHub repos under marcosmoura/* are owned by the user"
    ]
  }
}
