#!/usr/bin/env bash
#MISE description="Check that this Mac matches the repo, without changing anything"
# The "~/..." strings below are labels to print, not paths to expand.
# shellcheck disable=SC2088
set -euo pipefail
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

problems=0

# check <what> <fix> <command>...: run the command, report what and how to fix it.
check() {
  local what="$1" fix="$2"
  shift 2
  if "$@" >/dev/null 2>&1; then
    ok "$what"
  else
    warn "$what: no (fix: $fix)"
    problems=$((problems + 1))
  fi
}

# readlink and stat print nothing when the path is missing or not a link,
# which then simply fails the comparison.
links_to() { [[ "$(readlink "$1" 2>/dev/null || true)" == "$2" ]]; }
in_place() { [[ "$ROOT" == "$HOME/Projects/dotfiles" ]]; }
has_identity() { [[ -f "$ROOT/home/.config/git/identity" ]]; }
secrets_private() { [[ "$(stat -f %Lp "$HOME/.secrets" 2>/dev/null || true)" == 700 ]]; }
is_zsh() { [[ "$SHELL" == */zsh ]]; }

step "Links"
check "repo is at ~/Projects/dotfiles" "move it there; configs under home/ name that path" in_place
entries="$(managed)"
while IFS= read -r name; do
  check "~/$name" "mise run link" links_to "$HOME/$name" "$ROOT/home/$name"
done <<<"$entries"
check "~/.local/bin/figkit" "mise run tools" links_to "$HOME/.local/bin/figkit" "$ROOT/tools/figcraft/bin/figkit"

step "Machine-local files"
check "git identity" "mise run identity" has_identity
check "~/.secrets is private" "mise run identity, or chmod 700 ~/.secrets" secrets_private

step "Shell"
check "login shell is zsh" "chsh -s /bin/zsh" is_zsh

step "Homebrew"
check "everything in the Brewfile is installed" "mise run brew" \
  env HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --no-upgrade --file "$ROOT/home/Brewfile"

[[ "$problems" -eq 0 ]] || die "$problems check(s) failed"
ok "all good"
