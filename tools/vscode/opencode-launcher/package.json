{
  "name": "opencode-launcher",
  "displayName": "Launch OpenCode",
  "description": "Launch OpenCode inside the integrated terminal and keep the terminal title in sync with the active session.",
  "version": "0.0.1",
  "private": true,
  "publisher": "local",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "engines": {
    "vscode": "^1.114.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "opencodeLauncher.launch",
        "title": "Launch OpenCode",
        "category": "Launch OpenCode",
        "icon": {
          "dark": "assets/opencode-dark.svg",
          "light": "assets/opencode-light.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencodeLauncher.launch",
          "group": "navigation"
        }
      ],
      "terminal/title/context": [
        {
          "command": "opencodeLauncher.launch",
          "group": "1_create"
        }
      ],
      "terminal/context": [
        {
          "command": "opencodeLauncher.launch",
          "group": "1_create"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsdown",
    "watch": "tsdown --watch",
    "package": "pnpm run compile && pnpm exec vsce package --allow-missing-repository --out dist/opencode-launcher-${npm_package_version}.vsix"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/vscode": "^1.137.0",
    "@vscode/vsce": "^3.9.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
